# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA coloque o arquivo ".env" de verdade no Git — ele já está no .gitignore.

# String de conexão do MySQL (pegue no Easypanel, na página do serviço do banco)
DATABASE_URL="mysql://usuario:senha@host:3306/nome_do_banco"

# Chave usada para assinar a sessão de login do admin.
# Gere uma nova e única para produção com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Trocar este valor derruba todas as sessões ativas (todo mundo precisa logar de novo).
SESSION_SECRET=""

# Usuário/senha criados automaticamente na primeira vez que rodar o seed
# (npx prisma db seed), só se ainda não existir nenhum admin no banco.
# Depois do primeiro login, troque a senha em /admin/settings — essas
# variáveis não são mais usadas depois disso.
ADMIN_USERNAME="atipic"
ADMIN_PASSWORD="troque-esta-senha"

# Número de WhatsApp usado apenas como valor inicial (fallback) do seed.
# O número real usado no checkout é o configurado em /admin/settings.
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"
